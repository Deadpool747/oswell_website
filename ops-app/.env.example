OSWELL_DB_PATH=.oswell-data/oswell.sqlite
APP_MODE=live
NEXT_PUBLIC_APP_MODE=live
# Demo-backed dashboards are enabled for local development only. Production
# static builds with an API URL require this exact value to be false.
NEXT_PUBLIC_ENABLE_DEMO_DATA=true

# Point the browser at a separately deployed API when the FastAPI service is introduced.
NEXT_PUBLIC_API_URL=
# Used only by `npm run build:static`; set this to the public FastAPI HTTPS origin.
NEXT_PUBLIC_PRODUCTION_API_URL=https://api.example.com
# Required with a production API URL. These are public app-registration identifiers, not secrets.
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=
NEXT_PUBLIC_AZURE_AD_TENANT_ID=
NEXT_PUBLIC_AZURE_AD_API_SCOPE=api://YOUR_BACKEND_APP_ID/access_as_user
# Optional override when the Foundry routes are hosted at a different public API origin.
NEXT_PUBLIC_PRODUCTION_FOUNDRY_API_URL=
# Local FastAPI Microsoft Foundry provider service.
NEXT_PUBLIC_FOUNDRY_API_URL=http://127.0.0.1:8000/api/providers/azure
DATABASE_URL=
OPIK_API_KEY=
OPIK_URL=
OPIK_PROJECT=

OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
